+    const onX = ix === 0 ? -1 : ix === nx + 2 ? 1 : 0;
+    const onY = iy === 0 ? -1 : iy === ny + 2 ? 1 : 0;
+    const onZ = iz === 0 ? -1 : iz === nz + 2 ? 1 : 0;
