+export function makeSegmentedBeveledBox(
+  width: number,
+  height: number,
+  depth: number,
+  bevel = 0.02,
+  segsX = 2,
+  segsY = 2,
+  segsZ = 2,
+  warpFn?: (x: number, y: number, z: number) => [number, number, number],
+  hexColor = '#ffffff',
