+      acc,
+      sampleGrid(uCols, iv, true),
+      sampleGrid(uCols, iv, false),
+      sampleGrid(uCols, iv + 1, false),
+      sampleGrid(uCols, iv + 1, true),
+      [0, v0],
+      [1, v0],
+      [1, v1],
+      [0, v1],
+      [1, 0, 0]
+    );
+  }
+
+  return finishAccumToGeometry(acc, hexColor, options.shadeJitter ?? 0, options.offset ?? [0, 0, 0]);
+}
